{
  "name": "boxingundefeated.com",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "export": "cd apps/web && next build",
    "check:frontmatter": "tsx scripts/check-frontmatter.ts",
    "check:links": "lychee --config ./lychee.toml --verbose .",
    "clean": "git clean -xdf node_modules dist .next",
    "clean:workspaces": "turbo clean",
    "dev": "cross-env FORCE_COLOR=1 turbo dev --parallel",
    "format": "biome check --write .",
    "postinstall": "manypkg fix",
    "lint": "turbo lint && manypkg check",
    "lint:fix": "turbo lint:fix && manypkg fix && pnpm biome lint --write .",
    "shadcn": "cd packages/design-system && pnpm dlx shadcn@canary add",
    "start": "turbo run start",
    "syncpack:fix": "pnpm dlx syncpack fix-mismatches",
    "syncpack:list": "pnpm dlx syncpack list-mismatches",
    "test": "turbo test --cache-dir=.turbo",
    "test:watch": "turbo test:watch --cache-dir=.turbo",
    "typecheck": "turbo typecheck",
    "check": "biome check . && manypkg check && pnpm typecheck && pnpm test && pnpm build",
    "update": "pnpm update -r"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@manypkg/cli": "^0.23.0",
    "cross-env": "^7.0.3",
    "gray-matter": "^4.0.3",
    "lefthook": "^1.11.6",
    "tsx": "^4.23.15",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2"
  },
  "packageManager": "pnpm@10.7.1",
  "engines": {
    "node": ">=22"
  }
}
