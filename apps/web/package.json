{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "analyze": "ANALYZE=true next build --webpack",
    "build": "NODE_NO_WARNINGS=1 next build --debug && npx tsx scripts/generate-sitemaps.ts",
    "build:vercel": "NODE_NO_WARNINGS=1 next build && npx tsx scripts/generate-sitemaps.ts",
    "build:with-data": "node ../../scripts/split-boxer-data.js && npx tsx scripts/generate-boxer-search.ts && NODE_NO_WARNINGS=1 next build --debug && npx tsx scripts/generate-sitemaps.ts",
    "clean": "git clean -xdf .cache .turbo .next coverage node_modules",
    "predev": "node ../../scripts/split-boxer-data.js && npx tsx scripts/generate-boxer-search.ts",
    "dev": "NODE_OPTIONS='--inspect' next dev --port 3003",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "start": "next start",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "typecheck": "next typegen && tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@boxingundefeated/config-next": "workspace:*",
    "@boxingundefeated/config-typescript": "workspace:*",
    "@boxingundefeated/design-system": "workspace:*",
    "@boxingundefeated/utils": "workspace:*",
    "@icons-pack/react-simple-icons": "^12.3.0",
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@next/mdx": "^16.3.8",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.486.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "sonner": "^2.0.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.17",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-watch-typeahead": "^2.2.2",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.2"
  }
}
