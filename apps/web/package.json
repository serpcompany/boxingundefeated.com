{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "analyze": "ANALYZE=true next build --webpack",
    "build": "NODE_NO_WARNINGS=1 next build --debug && pnpm prune:export && npx tsx scripts/generate-sitemaps.ts",
    "build:vercel": "NODE_NO_WARNINGS=1 next build && pnpm prune:export && npx tsx scripts/generate-sitemaps.ts",
    "build:with-data": "node ../../scripts/split-boxer-data.js && npx tsx scripts/generate-boxer-search.ts && NODE_NO_WARNINGS=1 next build --debug && pnpm prune:export && npx tsx scripts/generate-sitemaps.ts",
    "build:worker": "NEXT_BUILD_TARGET=worker NODE_NO_WARNINGS=1 opennextjs-cloudflare build && npx tsx scripts/write-build-environment.ts",
    "build:worker:production": "SITE_ENVIRONMENT=production pnpm build:worker",
    "build:worker:staging": "SITE_ENVIRONMENT=staging pnpm build:worker",
    "check:build-environment": "npx tsx scripts/check-build-environment.ts",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts && npx tsx scripts/strip-main-module-type.ts",
    "clean": "git clean -xdf .cache .turbo .next coverage node_modules",
    "predev": "node ../../scripts/split-boxer-data.js && npx tsx scripts/generate-boxer-search.ts",
    "dev": "NODE_OPTIONS='--inspect' next dev --port 3003",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "preview:worker": "pnpm build:worker && pnpm serve:worker",
    "prune:export": "rm -rf out/_not-found",
    "serve:worker": "CHOKIDAR_USEPOLLING=1 CHOKIDAR_INTERVAL=60000 opennextjs-cloudflare preview --port 8787",
    "start": "next start",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "typecheck": "next typegen && tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@boxingundefeated/config-next": "workspace:*",
    "@boxingundefeated/config-typescript": "workspace:*",
    "@boxingundefeated/data-ops": "workspace:*",
    "@boxingundefeated/design-system": "workspace:*",
    "@icons-pack/react-simple-icons": "^12.3.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.486.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "sonner": "^2.0.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.8",
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.17",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-watch-typeahead": "^2.2.2",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.2",
    "wrangler": "4.147.0"
  }
}
