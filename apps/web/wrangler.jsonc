{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // The top level is local only: `wrangler dev` and `opennextjs-cloudflare preview` use it, it is
  // never deployed, and named envs don't inherit its bindings. Every deploy passes `--env`.
  "name": "boxingundefeated-com-local",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  // `global_fetch_strictly_public`: a fetch() to one of the zone's own hostnames goes out over the
  // public internet, as any other client's would, never straight to an origin. Inherited by every
  // env, like `upload_source_maps` and `keep_names` below.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Each deploy uploads the bundle's source maps, so Workers Logs maps stack traces to the original
  // files. Cloudflare keeps them out of band: they never reach a visitor or count toward the bundle.
  "upload_source_maps": true,
  // esbuild's keepNames wraps functions in `__name(...)`. Pages rendered on request (boxer
  // profiles, from D1) inline next-themes' script from `fn.toString()`, so the browser would get
  // a `__name` call it doesn't define. Inherited by every env.
  "keep_names": false,
  // The named envs inherit `assets`. OpenNext reads `run_worker_first` at build time to decide
  // which paths its asset resolver serves, so it is set once, here, for every env.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // The Worker runs before the files from `public/` (ads.txt), so the canonical-host redirect
    // and the crawl policy apply to them as well; OpenNext's asset resolver then serves them from
    // ASSETS. Each such request is a billed Worker invocation.
    // Hashed build output under /_next/static/ stays assets-first and free: crawlers don't index
    // it, and pages on the canonical host load it on every view.
    "run_worker_first": ["/*", "!/_next/static/*"]
  },
  "vars": {
    "SITE_ENVIRONMENT": "local",
    // `on` sends www and *.workers.dev to the environment's origin (lib/routing/canonical-host.ts).
    // Off locally, where the only host is localhost.
    "CANONICAL_HOST_REDIRECT": "off"
  },
  // The Worker version keys the edge cache (lib/worker/edge-cache.ts). Bindings aren't inherited,
  // so each env repeats it.
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "boxingundefeated-com-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "../../d1/drizzle",
      "migrations_table": "d1_migrations"
    }
  ],
  "env": {
    "staging": {
      "name": "boxingundefeated-com-staging",
      // Staging's canonical host. Wrangler attaches the custom domain and creates its DNS record
      // on deploy. With a route, `wrangler dev --env <env>` rewrites every Host header to the first
      // one, so test the host redirect locally on the top level with `--var` (apps/e2e/README.md).
      "routes": [{ "pattern": "staging.boxingundefeated.com", "custom_domain": true }],
      "workers_dev": true,
      "preview_urls": false,
      "observability": {
        "enabled": true
      },
      "vars": {
        "SITE_ENVIRONMENT": "staging",
        // Requests with the x-boxingundefeated-smoke-test header are exempt, so CI can test
        // through the workers.dev URL.
        "CANONICAL_HOST_REDIRECT": "on",
        // Staging's HTTP Basic auth password (lib/worker/staging-access.ts). Public on purpose, and
        // shared by every SERP site's staging (serp docs/engineering/standards/staging-access.md),
        // so a plain var, not a secret. Staging only: production and local never have it.
        "STAGING_BASIC_AUTH_PASSWORD": "stagingpassword"
      },
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      },
      // OpenNext calls its own Worker through WORKER_SELF_REFERENCE (on-demand revalidation and
      // its queue, neither of which the site uses yet), so each env binds its own Worker's name.
      // The local top level has none: a binding to the top level's own name makes `wrangler types`
      // import worker.ts into the type check, which then fails after a Worker build, as
      // `mainModule` did (lib/cloudflare-env-types.ts).
      "services": [
        { "binding": "WORKER_SELF_REFERENCE", "service": "boxingundefeated-com-staging" }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "boxingundefeated-com-staging",
          "database_id": "b623b536-620c-4c3c-8de7-7c0ca1599ee1",
          "migrations_dir": "../../d1/drizzle",
          "migrations_table": "d1_migrations"
        }
      ]
    },
    "production": {
      "name": "boxingundefeated-com-production",
      // Attached at the cutover (#19, 2026-10-06). Every deploy replaces the Worker's custom domains
      // with this list, so it must list every domain; removing an entry detaches that host.
      "routes": [
        { "pattern": "boxingundefeated.com", "custom_domain": true },
        { "pattern": "www.boxingundefeated.com", "custom_domain": true }
      ],
      "workers_dev": true,
      "preview_urls": false,
      "observability": {
        "enabled": true
      },
      "vars": {
        "SITE_ENVIRONMENT": "production",
        // Requests with the x-boxingundefeated-smoke-test header are exempt, so CI can test
        // through the workers.dev URL.
        "CANONICAL_HOST_REDIRECT": "on"
      },
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      },
      // This env's own Worker (see env.staging).
      "services": [
        { "binding": "WORKER_SELF_REFERENCE", "service": "boxingundefeated-com-production" }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "boxingundefeated-com-production",
          "database_id": "fb87aa80-babd-4962-8525-a65a36773144",
          "migrations_dir": "../../d1/drizzle",
          "migrations_table": "d1_migrations"
        }
      ]
    }
  }
}
