{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["SITE_ENVIRONMENT", "GITHUB_EVENT_NAME"],
      "outputs": [".next/**", "!.next/cache/**", "out/**"]
    },
    "build:vercel": {
      "dependsOn": ["^build"],
      "env": ["SITE_ENVIRONMENT", "GITHUB_EVENT_NAME"],
      "outputs": [".next/**", "!.next/cache/**", "out/**"]
    },
    "clean": {
      "cache": false
    },
    "typecheck": {
      "cache": false
    },
    "lint": {
      "cache": false
    },
    "lint:fix": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "test:watch": {
      "cache": false,
      "dependsOn": ["^build"]
    }
  }
}
